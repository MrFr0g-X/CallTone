# ── model_server runtime config ─────────────────────────────────────────────
# Copy to `.env` on the Vast instance. The setup_vast_instance.sh script
# generates MODEL_SERVER_TOKEN automatically; everything else is supplied
# by the operator.

# Shared secret — backend must present this as `Authorization: Bearer <token>`.
# Generate with:  openssl rand -hex 32
MODEL_SERVER_TOKEN=

# Comma-separated IPv4 allowlist. In production this is the app server's IP.
# During local integration tests you can set "127.0.0.1" or leave empty
# (an empty list disables the IP check but bearer auth still runs).
ALLOWED_IPS=91.99.208.254

# HuggingFace token — required at model download time for gated pyannote
# repos. Strip after bootstrap completes to reduce blast radius.
HF_TOKEN=

# Restrict CUDA to a single device. Vast instances usually have one, but
# setting this explicitly avoids llama-cpp picking a secondary that lacks
# enough VRAM.
CUDA_VISIBLE_DEVICES=0

# Set to "1" to expose /docs on a test run. MUST be unset in production —
# the server does not need a public schema.
MODEL_SERVER_DEBUG=0
