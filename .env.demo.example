# Copy this file to .env.demo and fill in the two values from the Vast bootstrap.
# Never commit .env.demo — it's in .gitignore by pattern.

# Base URL your laptop uses to reach the model server.
# For the SSH tunnel flow: http://127.0.0.1:8090
# For direct public access (not recommended for demo): http://185.65.93.114:<port>
MODEL_SERVER_URL=http://127.0.0.1:8090

# Shared secret printed by setup_vast_instance.sh.
# Copy the hex string into this value.
MODEL_SERVER_TOKEN=paste-the-token-from-vast-here
