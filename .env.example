# ─── CallTone environment template ─────────────────────────────────────────
# Copy this to:
#   .env.staging   for the staging stack
#   .env.prod      for the production stack
# Then fill in real values. NEVER commit a populated .env* file —
# .gitignore already covers them.
#
# Generate strong secrets with:
#   openssl rand -hex 32     # SECRET_KEY
#   openssl rand -hex 24     # POSTGRES_PASSWORD
# ───────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-openssl-rand-hex-32
DEBUG=false
CORS_ORIGINS=https://calltone.local

# ── Database (prod uses Postgres; staging can leave DB_HOST="" for SQLite) ─
DB_HOST=postgres
DB_PORT=5432
DB_NAME=calltone
DB_USER=calltone
DB_PASSWORD=replace-with-openssl-rand-hex-24

# Mirror credentials so the postgres side-car picks them up
POSTGRES_DB=calltone
POSTGRES_USER=calltone
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# ── HuggingFace (pyannote license-gated weights) ──────────────────────────
HF_TOKEN=hf_replace_me
